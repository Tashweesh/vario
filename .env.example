# Supabase project (Project Settings → API). For `supabase start` use the values it prints.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: map tiles (defaults to OpenStreetMap; attribution is HTML)
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTR=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
